# Auth (obbligatorio in produzione)
AUTH_SECRET=genera-una-stringa-casuale-lunga
AUTH_DEMO_MODE=true
# URL pubblico (dopo deploy Fly: https://sostituzioni-docenti.fly.dev)
AUTH_URL=http://localhost:3000

# SQLite — locale: lascia vuoto (usa data/sostituzioni.sqlite)
# Produzione Fly/Railway: volume su /data
SQLITE_PATH=

# Opzionale — Google Workspace scuola (dopo la prova demo)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
